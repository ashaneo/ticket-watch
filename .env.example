# Pages to watch (comma-separated). Change this to track any other movie.
WATCH_URLS=https://www.scopecinemas.com/movies/avengers-doomsday
CHECK_INTERVAL=300          # seconds (300 = 5 min)
FAIL_ALERT_AFTER=12         # alert if the page can't be read 12 times in a row (~1 hour)

# --- Email (Gmail: use an App Password, not your normal password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
EMAIL_TO=you@gmail.com

# --- Telegram (recommended phone alert) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- WhatsApp (optional; leave WHATSAPP_TO empty to disable) ---
WHATSAPP_PROVIDER=callmebot  # callmebot or twilio
WHATSAPP_TO=
CALLMEBOT_APIKEY=

# Only if WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
